# Copy this file to .env and fill in your key.
#
# Get a Google Maps Platform API key with the Air Quality, Weather, and
# Pollen APIs all enabled: https://console.cloud.google.com/google/maps-apis/api-list
# Requires a Cloud billing account attached to the project. Free monthly
# volumes before charges kick in (see https://developers.google.com/maps/billing-and-pricing/pricing):
#   - Air Quality Usage: 10,000 free/month, then $5.00 per 1,000
#   - Weather Usage:     10,000 free/month, then $0.15 per 1,000
#   - Pollen Usage:       5,000 free/month, then $10.00 per 1,000
GOOGLE_MAPS_API_KEY=your-key-here
